# --- Firebase ---
# Path to the service-account JSON downloaded from Firebase console
# (Project Settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# --- AI providers ---
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro

# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# --- Toggles ---
# Set MOCK_AI=1 during frontend development to skip real AI calls.
MOCK_AI=0

# --- Observability ---
# Optional. Get from https://sentry.io (free tier).
SENTRY_DSN=

# --- App ---
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Vercel deployment (optional) ---
# Both must be set for auto-deploy to fire after generation.
# Get a token at https://vercel.com/account/tokens
# Get a Postgres URL at https://neon.tech (free tier available)
DEMAESTRO_VERCEL_TOKEN=
DEMAESTRO_POSTGRES_URL=
# Set to "false" to disable auto-deploy even when credentials are set.
DEMAESTRO_AUTO_DEPLOY=true
