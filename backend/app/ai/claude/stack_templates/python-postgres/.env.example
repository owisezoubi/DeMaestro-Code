# Database — defaults to a zero-config local SQLite file (no setup needed).
# To use Postgres instead (e.g. Docker), set DATABASE_URL to a postgresql:// URL.
DATABASE_URL=sqlite:///./app.db
# Postgres settings below are only used by docker-compose:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB="{{app_slug}}"

# JWT
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backend
BACKEND_PORT=8100
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5273,http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8100
VITE_APP_NAME="{{app_name}}"
VITE_PORT=5273
