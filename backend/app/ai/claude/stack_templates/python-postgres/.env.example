# Local dev — defaults work without setting any of these
DATABASE_URL=sqlite:///./app.db
JWT_SECRET_KEY=local-dev-only-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOW_LOCALHOST_CORS=true
BACKEND_PORT=8100
ENVIRONMENT=development

# Postgres settings (only used when docker-compose is running)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB="{{app_slug}}"

# Production overrides — uncomment and fill in for deployed environments:
# CORS_ORIGINS=https://your-app.vercel.app
# ALLOW_LOCALHOST_CORS=false
# JWT_SECRET_KEY=<openssl rand -hex 32>
# DATABASE_URL=postgresql://user:password@host:5432/dbname
